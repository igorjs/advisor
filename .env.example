# LLM provider (OpenAI-compatible: OpenAI, OpenRouter, Ollama, etc.)
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1          # default: OpenAI
# LLM_MODEL=gpt-4o-mini                            # default model

# Web search (Jina Search API: s.jina.ai)
JINA_API_KEY=your-jina-api-key

# Server configuration
PORT=3001
DATABASE_URL=file:data/advisor.db

# Client origin for CORS (default: Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Turso credentials (optional: omit for local-only SQLite)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
