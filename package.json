    "db:migrate": "pnpm --filter server run db:migrate"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.9",
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
