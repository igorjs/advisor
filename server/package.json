  },
  "dependencies": {
    "@hono/node-server": "2.0.2",
    "@libsql/client": "0.17.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.18",
    "openai": "6.37.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
